# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/ursmajestic

# ── Secret key ─────────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER use the placeholder value in production.
SECRET_KEY=change-me-to-a-random-64-char-hex-secret

# ── Environment ────────────────────────────────────────────────────────────────
# Set to "production" on the host to enable HTTPS redirect, HSTS, Secure cookies,
# hidden error pages, and disabled API docs.
ENVIRONMENT=development

# ── Admin origin ───────────────────────────────────────────────────────────────
# The exact origin of the admin frontend for CORS. Must match the deployed URL.
ADMIN_ORIGIN=https://admin.ursmajestic.com

# ── Upload limits ──────────────────────────────────────────────────────────────
UPLOAD_MAX_MB=10

# ── Login rate-limiting ────────────────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# ── WhatsApp Daily Brief (Meta Cloud API) ───────────────────────────────────────
# Leave TOKEN/PHONE_ID blank to keep the daily job in dry-run (prints, never sends).
# Set on the Render Cron Job service. 1 PM IST = "30 7 * * *" (UTC) running
#   python -m scripts.send_daily_whatsapp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=daily_brief
# Order-only template used by the 8 PM IST run ("30 14 * * *" UTC):
#   python -m scripts.send_daily_whatsapp --only order
WHATSAPP_ORDER_TEMPLATE_NAME=order_forecast
WHATSAPP_TEMPLATE_LANG=en
# Verify token for the /webhooks/whatsapp GET handshake -- any string you invent,
# must match the "Verify token" set in Meta's WhatsApp > Configuration > Webhook.
# Without this, POST /messages accept != actual delivery is invisible (see whatsapp_webhook_events).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# E.164 without '+', comma-separated (91 = India):
WHATSAPP_RECIPIENTS=919150102001,919884194662,919985335358

# ── Daily Brief (Telegram bot) ──────────────────────────────────────────────
# No template approval needed — set up once via @BotFather + @userinfobot
# (see the docstring in scripts/send_daily_telegram.py for the exact steps).
# Leave TOKEN blank to keep the daily job in dry-run. Same Render Cron Job
# schedules as WhatsApp:
#   30 7  * * *  ->  python -m scripts.send_daily_telegram
#   30 14 * * *  ->  python -m scripts.send_daily_telegram --only order
TELEGRAM_BOT_TOKEN=
# Numeric chat IDs, comma-separated (owner + kitchen) — each must have
# messaged the bot once before it can message them back.
TELEGRAM_CHAT_IDS=

# ── Receipt OCR + archival ──────────────────────────────────────────────────
# OCR: OCR.space (free hosted API, no system binary). Free key at
# https://ocr.space/ocrapi ; blank uses the shared "helloworld" demo key (works
# but is rate-limited).
OCR_SPACE_API_KEY=
# Archival: uploaded receipts are saved to a Google Drive folder. Create a
# service account, share the folder with its email (Editor), paste the JSON key
# here. Both blank -> OCR + purchase creation still work, only archival is skipped.
GOOGLE_SERVICE_ACCOUNT_JSON=
GDRIVE_RECEIPTS_FOLDER_ID=
