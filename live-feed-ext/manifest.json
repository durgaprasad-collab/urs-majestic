{
  "manifest_version": 3,
  "name": "URS Live Stock Feed",
  "version": "1.0.0",
  "description": "Reads Petpooja's live Item Report about every 10 minutes and sends it to admin.ursmajestic.com (Live stock tab). Read only.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": [
    "https://admin.ursmajestic.com/*",
    "https://billing.petpooja.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "URS Live Stock Feed" },
  "content_scripts": [
    {
      "matches": ["https://billing.petpooja.com/custom_reports/view_report/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://billing.petpooja.com/custom_reports/view_report/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
