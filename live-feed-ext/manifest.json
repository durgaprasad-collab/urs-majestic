{
  "manifest_version": 3,
  "name": "URS Live Stock Feed",
  "version": "1.7.0",
  "description": "Reads Petpooja's live Item Report and All Orders about every 10 minutes and sends them to admin.ursmajestic.com (Live stock tab). Also switches the tandoori items off from 3:30 PM to 6:30 PM daily in Petpooja's Online Menu.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": [
    "https://admin.ursmajestic.com/*",
    "https://billing.petpooja.com/*",
    "https://menu.petpooja.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "URS Live Stock Feed" },
  "content_scripts": [
    {
      "matches": ["https://billing.petpooja.com/custom_reports/view_report/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://billing.petpooja.com/custom_reports/view_report/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://billing.petpooja.com/orders/order_list/*"],
      "js": ["ol.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://billing.petpooja.com/users/dashboard*"],
      "js": ["dash.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://menu.petpooja.com/menus/item_on_off/*"],
      "js": ["menu.js"],
      "run_at": "document_idle"
    }
  ]
}
